# Frontend (Vite) — exposed to the browser, safe to be public.
# GitHub Actions variables (or secrets) of the same names are passed into
# the Pages build. Never put a secret key in a VITE_ variable.
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=

# Supabase Edge Function (src/supabase/functions/server) — set as Supabase
# secrets (`supabase secrets set`), NEVER as VITE_ variables. Anything
# prefixed VITE_ is inlined into the public JS bundle at build time.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_SERVICE_API_KEY=

# Comma-separated browser origins allowed to call the function.
# If unset, the function allows https://www.creova.one and https://creova.one.
# A lone "*" is ignored. Add http://localhost:5173 here only for local dev.
ALLOWED_ORIGINS=https://www.creova.one,https://creova.one

# Leave CREOVA_ENV unset in production. Set it only for a dev, local, or
# test function process (exact values: development, dev, local, test) so
# Turnstile can be skipped when TURNSTILE_SECRET_KEY is empty. A hosted
# function whose SUPABASE_URL contains .supabase.co never skips captcha.
# CREOVA_ENV=

# Admin dashboard auth (/admin/*, /analytics/dashboard).
# ADMIN_PASSWORD is checked once, server-side, in the /admin-login route —
# it is never sent to or compared in the browser.
# ADMIN_SESSION_SECRET signs the session token issued after a successful
# login; every admin-only route verifies that signature before doing
# anything. Generate a long random value, e.g.: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
